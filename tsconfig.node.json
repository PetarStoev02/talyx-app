{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "src/shared/**/*","electron.vite.config.*", "src/main/**/*", "src/preload/**/*", "src/splash/preload.ts", "tests/smoke/**/*", "tests/types/**/*", "vitest.smoke.config.ts"],
  "compilerOptions": {
    "composite": true,
    "exactOptionalPropertyTypes": true,
    "types": ["electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@contract/*": ["src/shared/*"]
    }
  }
}

{
  "name": "talyx",
  "version": "0.11.0",
  "description": "AI personal assistant and file organizer for macOS",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "homepage": "https://talyx.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/PetarStoev02/talyx-app.git"
  },
  "bugs": {
    "url": "https://github.com/PetarStoev02/talyx-app/issues"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache src tests",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "install-electron && electron-vite preview",
    "dev": "install-electron && electron-vite dev",
    "dev:fresh": "node scripts/fresh.mjs && install-electron && electron-vite dev",
    "fresh": "node scripts/fresh.mjs",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:mac": "electron-vite build && electron-builder --mac --publish never",
    "release": "bash scripts/release.sh",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@anthropic-ai/sdk": "^0.133.0",
    "@huggingface/hub": "^2.11.0",
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-virtual": "^3.13.21",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.3",
    "exifr": "^7.1.3",
    "lucide-react": "^0.577.0",
    "mailparser": "^3.9.4",
    "mammoth": "^1.11.0",
    "music-metadata": "^11.12.1",
    "pdf-parse": "^2.4.5",
    "phonemizer": "^1.2.1",
    "radix-ui": "^1.4.3",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "thinking-orbs": "^0.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.9.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "playwright-core": "^1.61.1",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.18"
  }
}
